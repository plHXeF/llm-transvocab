# 可选：也可以完全在应用侧栏中配置并保存。
# 模型默认通过 GUI 调用 /models 实时搜索，因此通常无需填写 VOCAB_MODEL。
VOCAB_BASE_URL=https://api.deepseek.com
VOCAB_API_KEY=
VOCAB_MODEL=
VOCAB_REASONING_EFFORT=disabled

# 可选路径；相对路径由启动进程的工作目录解析。
# VOCAB_FILE=/absolute/path/to/vocabularies.csv
# VOCAB_SETTINGS_FILE=/absolute/path/to/data/app_settings.json
# VOCAB_API_KEYS_FILE=/absolute/path/to/data/api_keys.json
# VOCAB_LEARNING_DB_FILE=/absolute/path/to/data/learning.db
